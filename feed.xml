---
layout: null
lang: fr
sitemap: false
---
{%- assign t = site.data[page.lang] -%}
{%- assign posts = site.posts | where: "lang", page.lang -%}
{%- assign talks = site.talks | where: "lang", page.lang -%}
{%- assign items = posts | concat: talks | sort: "date" | reverse -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <link>{{ t.urls.home | absolute_url }}</link>
  <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml"/>
  <description>{{ t.meta.description | xml_escape }}</description>
  <language>{{ t.lang }}</language>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  {%- for item in items limit: 20 %}
  <item>
    <title>{{ item.title | xml_escape }}</title>
    <link>{{ item.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ item.url | absolute_url }}</guid>
    <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
    <description>{{ item.summary | default: item.description | default: item.excerpt | strip_html | xml_escape }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
